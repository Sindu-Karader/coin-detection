# train_model.py
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
import numpy as np

# 1️⃣ Load or prepare your data
# For demo — we’ll create random image data (replace this with your dataset)
# X_train: images, y_train: labels
X_train = np.random.rand(100, 64, 64, 3)   # 100 sample 64x64 RGB images
y_train = np.random.randint(0, 5, 100)     # 5 coin classes

# Normalize pixel values (0–1)
X_train = X_train / 255.0

# 2️⃣ Define a simple CNN model
model = keras.Sequential([
    layers.Conv2D(32, (3, 3), activation='relu', input_shape=(64, 64, 3)),
    layers.MaxPooling2D(2, 2),
    layers.Conv2D(64, (3, 3), activation='relu'),
    layers.MaxPooling2D(2, 2),
    layers.Flatten(),
    layers.Dense(128, activation='relu'),
    layers.Dense(5, activation='softmax')  # 5 output classes
])

# 3️⃣ Compile the model
model.compile(optimizer='adam',
              loss='sparse_categorical_crossentropy',
              metrics=['accuracy'])

# 4️⃣ Train the model
model.fit(X_train, y_train, epochs=5, batch_size=16)

# 5️⃣ Save the model in .keras format
model.save("coin_model.keras")
print("✅ Model trained and saved successfully as coin_model.keras")
